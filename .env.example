# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model Engine
GEMINI_MODEL=gemini-3.8-flash

# Active Operator Identifier (e.g., student_1, student_2, operator_a)
OPERATOR_NAME=your_operator_name_here

# Optional Google Apps Script Webhook URL for real-time cloud sheet sync
SHEET_WEBHOOK_URL=

# Bytecode Cache Directory
PYTHONPYCACHEPREFIX=.cache/pycache

